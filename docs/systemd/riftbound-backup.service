# Nightly database backup: venv/bin/python scripts/db_backup.py. Template: user,
# paths and environment file are the same placeholders as docs/riftbound.service;
# adapt them to the server. Install and rollback:
# docs/knowledge/ops-runbook.md -> "Nightly backup".
[Unit]
Description=Riftbound nightly database backup (pg_dump)
After=network.target

[Service]
Type=oneshot
User=www-data
Group=www-data
WorkingDirectory=/var/www/riftbound
EnvironmentFile=/etc/riftbound/riftbound.env
ExecStart=/var/www/riftbound/venv/bin/python /var/www/riftbound/scripts/db_backup.py
