# Daily purge of ended server-side sessions (F9-a): queues the sessions_purge job
# unless one already succeeded today (UTC); the job runner (riftbound-jobs.timer)
# runs it. Same placeholders as docs/riftbound.service and riftbound-jobs.service.
# Install and rollback: docs/knowledge/ops-runbook.md -> "Scheduled jobs" ->
# "Session purge (F9-a)".
[Unit]
Description=Queue the Riftbound session purge
After=network.target

[Service]
Type=oneshot
User=www-data
Group=www-data
WorkingDirectory=/var/www/riftbound
Environment="PATH=/var/www/riftbound/venv/bin"
Environment="FLASK_APP=wsgi.py"
EnvironmentFile=/etc/riftbound/riftbound.env
ExecStart=/var/www/riftbound/venv/bin/flask jobs enqueue sessions_purge --unless-succeeded-today
