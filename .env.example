# Riftbound environment variables (copy to `.env`, never commit real values).
#
# - `.env` is git-ignored and is read ONLY when RB_ENV=development.
# - In production set the same variables through the service's EnvironmentFile
#   (/etc/riftbound/riftbound.env, mode 640 root:www-data); see docs/riftbound.service.
# - The app fails to start if a required value is missing or weak. The error
#   names the variable, never its value.

# development | testing | production. When unset the app runs as production.
RB_ENV=development

# Required outside development: 32+ random characters, never a placeholder.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-generate-a-random-key-with-secrets-token_urlsafe-48

# Required in every environment. PostgreSQL with the psycopg driver.
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/riftbound

# --- Optional -----------------------------------------------------------------

# Local entry point (python run.py). Debug is OFF and the bind is loopback by default.
# RB_HOST=127.0.0.1
# RB_PORT=5000
# FLASK_DEBUG=0   # 1 enables the Werkzeug debugger; refused when RB_ENV=production

# Reverse proxy: how many X-Forwarded-* hops to trust (Nginx in front = 1, 0 = none).
# PROXY_FIX_X_FOR=1
# PROXY_FIX_X_PROTO=1
# PROXY_FIX_X_HOST=1

# Hosts an admin may point the Cardmarket loader at (price/cardmarket-load URL
# overrides), comma separated. Default: the host of the built-in download URLs.
# CARDMARKET_ALLOWED_HOSTS=downloads.s3.cardmarket.com

# Migration 0002 saves the legacy tables (e-mails + password hashes!) here before
# dropping them. Default: <project>/instance/backups (git-ignored). NEVER commit it.
# RB_LEGACY_BACKUP_DIR=/var/backups/riftbound

# --- Cookies, CSRF, login protection, captcha, landing cache (unit d) ------------
# Everything below has a safe default; set a line only to change it.

# Session and remember cookies are always HttpOnly + SameSite=Lax. Secure defaults to
# true in production and false elsewhere; behind an HTTPS proxy in development you may
# want true. A Secure cookie is only sent over HTTPS.
# SESSION_COOKIE_SECURE=false
# REMEMBER_COOKIE_SECURE=false

# Kill switches (rollback only: each logs a warning when off outside RB_ENV=testing).
# WTF_CSRF_ENABLED=true        # false = no CSRF check on POST/PUT/PATCH/DELETE
# RATELIMIT_ENABLED=true       # false = no per-IP limits on login / register
# CAPTCHA_PROVIDER=altcha      # altcha | none (none = no captcha on register)

# Rate limiter storage. memory:// is per Gunicorn worker (Nginx limit_req is the
# global limit, see docs/nginx_config). A shared store would be redis://host:6379.
# RATELIMIT_STORAGE_URI=memory://

# Account lockout: the LOGIN_MAX_FAILURES-th consecutive failure locks the account for
# LOGIN_LOCK_BASE_MINUTES, then each further failure doubles it, up to LOGIN_LOCK_MAX_MINUTES.
# Unlock by hand: flask users unlock <username>
# LOGIN_MAX_FAILURES=5
# LOGIN_LOCK_BASE_MINUTES=15
# LOGIN_LOCK_MAX_MINUTES=1440

# ALTCHA (captcha on register). The HMAC key signs the challenges; when empty it is
# derived from SECRET_KEY, so rotating SECRET_KEY also invalidates open challenges.
# ALTCHA_HMAC_KEY=
# ALTCHA_EXPIRE_SECONDS=300    # how long a solved challenge stays valid
# ALTCHA_MAX_NUMBER=1000000    # difficulty (higher = slower to solve)

# Landing page partials (news, tournaments, videos, decks) are cached per Gunicorn
# worker for this many seconds. 0 turns the cache off.
# LANDING_CACHE_TTL=300
