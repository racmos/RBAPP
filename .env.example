# Riftbound environment variables (copy to `.env`, never commit real values).
#
# - `.env` is git-ignored and is read ONLY when RB_ENV=development.
# - In production set the same variables through the service's EnvironmentFile
#   (/etc/riftbound/riftbound.env, mode 640 root:www-data); see docs/riftbound.service.
# - The app fails to start if a required value is missing or weak. The error
#   names the variable, never its value.

# development | testing | production. When unset the app runs as production.
RB_ENV=development

# Required outside development: 32+ random characters, never a placeholder.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-generate-a-random-key-with-secrets-token_urlsafe-48

# Required in every environment. PostgreSQL with the psycopg driver.
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/riftbound

# --- Optional -----------------------------------------------------------------

# Local entry point (python run.py). Debug is OFF and the bind is loopback by default.
# RB_HOST=127.0.0.1
# RB_PORT=5000
# FLASK_DEBUG=0   # 1 enables the Werkzeug debugger; refused when RB_ENV=production

# Reverse proxy: how many X-Forwarded-* hops to trust (Nginx in front = 1, 0 = none).
# PROXY_FIX_X_FOR=1
# PROXY_FIX_X_PROTO=1
# PROXY_FIX_X_HOST=1

# Hosts an admin may point the Cardmarket loader at (price/cardmarket-load URL
# overrides), comma separated. Default: the host of the built-in download URLs.
# CARDMARKET_ALLOWED_HOSTS=downloads.s3.cardmarket.com

# Migration 0002 saves the legacy tables (e-mails + password hashes!) here before
# dropping them. Default: <project>/instance/backups (git-ignored). NEVER commit it.
# RB_LEGACY_BACKUP_DIR=/var/backups/riftbound

# --- Added by later units of the f0-foundation change (NOT read yet) ------------
# SESSION_COOKIE_SECURE=true                    # cookie flags
# REMEMBER_COOKIE_SECURE=true
# WTF_CSRF_ENABLED=true                         # CSRF protection kill switch
# RATELIMIT_ENABLED=true                        # login/register rate limiter
# RATELIMIT_STORAGE_URI=memory://
# CAPTCHA_PROVIDER=altcha                       # altcha | none
# ALTCHA_HMAC_KEY=                              # defaults to a key derived from SECRET_KEY
# LANDING_CACHE_TTL=300                         # seconds
